# ---------------------------------------------------------------------------
# CareNest — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# Public origin of the app (used for canonical URLs, Stripe redirects, links in email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local development default (Prisma SQLite file, zero setup):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (see README "Switching the database to PostgreSQL"):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/carenest?schema=public"

# --- Auth -------------------------------------------------------------------
# 32+ random bytes, base64/hex. Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
# Session lifetime in days
SESSION_TTL_DAYS=30

# --- Email (Resend or SMTP) -------------------------------------------------
# If RESEND_API_KEY is empty, emails are logged to the server console and stored
# in the Notification table (development transport).
RESEND_API_KEY=
EMAIL_FROM="CareNest <hello@carenest.example>"
# Optional SMTP fallback (used when RESEND_API_KEY is empty but SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Stripe -----------------------------------------------------------------
# Without these the app uses a clearly-labelled sandbox checkout that records
# payments locally and never claims to be a real charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=usd

# --- Uploads / object storage ----------------------------------------------
# driver: "local" (default, files under ./storage/uploads) or "cloudinary"
UPLOAD_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=carenest
MAX_UPLOAD_MB=8

# --- Redis (optional: rate limiting + caching) ------------------------------
# When empty, an in-process limiter is used (fine for a single Node instance).
REDIS_URL=

# --- Google Maps (optional) -------------------------------------------------
# Used for the map view on search results. Falls back to a static map frame.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Platform fees (admin-editable in DB too; these are seed defaults) -----
PLATFORM_FEE_BPS=500
